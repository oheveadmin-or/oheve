PORT=3003
NODE_ENV=development

# CORS : liste des origines autorisées en production (séparées par des virgules, sans espace).
# Ex. : https://app.oheve.com,https://oheve.com
# En dev (NODE_ENV != production), laisser vide = tout autorisé (mobile natif).
ALLOWED_ORIGINS=https://app.oheve.com,https://oheve.com

# Gmail SMTP (pour OTP inscription)
# Créer un mot de passe d'application : https://myaccount.google.com/apppasswords
SMTP_USER=ton.email@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=The Event Wedding <ton.email@gmail.com>

# JWT pour les routes protégées (ex. POST /api/public-sites). Minimum 16 caractères.
JWT_SECRET=

# Connexion Google native : vérification de l'id_token côté serveur.
# GOOGLE_WEB_CLIENT_ID = MÊME valeur que EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (audience de l'id_token). Obligatoire.
# GOOGLE_IOS_CLIENT_ID = optionnel, accepté comme audience de secours.
GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com


# URL publique où est déployé le site invités (dossier guest-site du repo).
# L’API renvoie publicUrl = PUBLIC_SITE_BASE_URL + "/" + slug.
# En local (guest-site : npm run dev) : IP du Mac + 5173 en HTTP, ex. :
#   PUBLIC_SITE_BASE_URL=http://172.20.10.4:5173
# En production : ton domaine HTTPS (sans slash final).
PUBLIC_SITE_BASE_URL=

# Optionnel en dev : si PUBLIC_SITE_BASE_URL contient 127.0.0.1 ou localhost, remplacé par cette IP (défaut 172.20.10.4).
DEV_LAN_HOST=

# Sentry — monitoring d'erreurs (facultatif, mais fortement recommandé en prod)
# Créer un projet sur sentry.io, copier le DSN
SENTRY_DSN=

# Supabase - Récupérer dans: Project Settings > Database > Connection string (URI)
# Format: postgresql://postgres.[PROJECT-REF]:[MOT-DE-PASSE]@aws-0-XX.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Demandes aux prestataires (« Contacter un prestataire ») ──────────────────
# Demandes offertes à chaque prestataire non abonné (la suivante est verrouillée).
FREE_REQUESTS_LIMIT=4
# Anti-spam : nouvelles demandes max par client sur 24 h.
DEMANDES_MAX_PER_CLIENT_24H=5
# E-mails envoyés via Resend « au nom d'Ohevé » (domaine vérifié dans Resend).
RESEND_API_KEY=
EMAIL_FROM_NAME=Ohevé
EMAIL_FROM_ADDRESS=noreply@ohevewedding.com
# Logo affiché en haut des e-mails (URL HTTPS publique d'une image PNG).
LOGO_URL=
# Site public (pages /demande/:id, /prestataire/:id, /se-desabonner), sans slash final.
SITE_URL=https://ohevewedding.com
# URL publique de l'API (désinscription en un clic depuis Gmail/Outlook).
API_PUBLIC_URL=https://oheve-production.up.railway.app
# Secrets (32+ caractères aléatoires chacun, DIFFÉRENTS de JWT_SECRET) :
# lien magique « Voir la demande » (30 jours) et lien « Ne plus recevoir de demandes ».
DEMANDE_LINK_SECRET=
UNSUBSCRIBE_SECRET=
# Stripe : prix du déblocage à l'unité (paiement unique, price_…).
STRIPE_PRICE_DEBLOCAGE=
# Prix de l'abonnement pour Checkout ; vide = prix de l'abonnement prestataire existant.
STRIPE_PRICE_ABONNEMENT=
# Déjà utilisés : STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (signature des webhooks).
# Fiche App Store de l'app (lien « Télécharger l'app » des e-mails prestataire) — facultatif
APP_STORE_URL=
